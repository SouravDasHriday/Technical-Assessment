# Copy .env.example → .env and fill in real values before running:
#   docker compose up --build

PORT=4000

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DB_USER=appuser
DB_PASSWORD=apppass
DB_NAME=appdb

# Simulated read/write split — both point at the same local instance.
# In a real cluster DB_READ_URL would point to a replica.
DB_WRITE_URL=postgres://appuser:apppass@postgres:5432/appdb
DB_READ_URL=postgres://appuser:apppass@postgres:5432/appdb

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Search ─────────────────────────────────────────────────────────────────────
SEARCH_URL=http://elasticsearch:9200
